# Portfolio Environment Configuration

# Contact Form Email Delivery (Option A - Next.js Nodemailer)
# Recipient email where all portfolio inquiries will land:
CONTACT_TO_EMAIL="ajupoolat@gmail.com"

# Live Gmail SMTP Credentials:
# To send live emails from your Gmail account:
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Make sure 2-Step Verification is ON
# 3. Search for "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Generate an App Password for "Portfolio Website" (a 16-character code like "abcd efgh ijkl mnop")
# 5. Place it below in your .env.local file:
EMAIL_USER="ajupoolat@gmail.com"
EMAIL_PASS="your-16-char-app-password-here"

# (Optional) If using custom SMTP instead of Gmail:
# SMTP_SERVICE="gmail"
